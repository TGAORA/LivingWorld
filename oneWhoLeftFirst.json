      "type":"context",
      "index":1,
      "text":[
        "Mara waits near outward roads and river crossings, never inside the safest center.",
        "She watches the sky more than she watches people."
      ]
    },
    {
      "type":"dialogue",
      "index":2,
      "speakers":[
        "Mara",
        "Player"
      ],
      "lines":[
        {
          "speaker":"Mara",
          "text":[
            "“Not yet,” she said, glancing past your shoulder.",
            "“But soon enough. Leave while leaving is still easy.”"
          ],
          "tone":"calm, urgent-underneath",
          "actionReference":"warn_exit"
        },
        {
          "speaker":"Player",
          "text":[
            "(ANYTHING SAID)"
          ],
          "tone":null,
          "actionReference":null
        },
        {
          "speaker":"Mara",
          "text":[
            "“I’ve seen places turn,” she added, then stopped.",
            "“I won’t tell you what that looked like.”"
          ],
          "tone":"restrained, final",
          "actionReference":null
        }
      ]
    }
  ],
