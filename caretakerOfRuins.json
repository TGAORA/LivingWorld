      ],
      "lines":[
        {
          "speaker":"Irel",
          "text":[
            "“It hasn’t fallen yet,” they said quietly, adjusting a loose stone."
          ],
          "tone":"quite",
          "actionReference":"maintain"
        },
        {
          "speaker":"Player",
          "text":[
            "(ANYTHING SAID)"
          ],
          "tone":null,
